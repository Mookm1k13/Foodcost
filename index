let purchaseFilter = {q:'', cat:''};
let saleFilter = {q:'', platformId:'', dateFrom:'', dateTo:''};
RENDERERS.purchases = function(){
  const sorted = [...DB.purchases].sort((a,b)=> a.date<b.date?1:-1);
  const purchaseCats = [...new Set(DB.ingredients.map(i=>i.category).filter(Boolean))];
  const filtered = sorted.filter(p=>{
    const ingr = ingrById(p.ingredientId);
    if(purchaseFilter.cat && (!ingr || ingr.category!==purchaseFilter.cat)) return false;
    if(purchaseFilter.q){
      const q = purchaseFilter.q.toLowerCase();
      const hay = `${ingr?ingr.name:''} ${p.note||''}`.toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });
  const rows = filtered.map(p=>{
    const ingr = ingrById(p.ingredientId);
    return `<tr>
      <td>${fmtDate(p.date)}</td>
      <td class="cell-strong">${ingr?esc(ingr.name):'(ลบแล้ว)'}</td>
      <td class="num">${fmtNum(p.qty)} ${ingr?esc(ingr.unit):''}</td>
      <td class="num">${fmtMoney(p.price)}</td>
      <td class="num">${fmtMoney(p.pricePerUnit)}</td>
      <td>${esc(p.note||'-')}</td>
      <td><div class="row-actions">
        <button class="icon-btn" title="แก้ไข" onclick="openPurchaseModal('${p.id}')">✏️</button>
        <button class="icon-btn" title="ลบ" onclick="deletePurchase('${p.id}')">🗑️</button>
      </div></td>
    </tr>`;
  }).join('') || `<tr class="empty-row"><td colspan="7">${sorted.length===0?'ยังไม่มีประวัติการซื้อ':'ไม่พบรายการที่ตรงกับการค้นหา/ตัวกรอง'}</td></tr>`;

  const summary = DB.ingredients.map(i=>{
    const stats = purchaseStats(i.id);
    if(stats.count===0) return '';
    return `<div class="mini-list-item">
      <span class="name">${esc(i.name)}</span>
      <span class="val" style="font-size:12.8px;font-weight:500;">ล่าสุด ${fmtMoney(i.latestPrice)} · เฉลี่ย ${fmtMoney(i.avgPrice)} · ต่ำสุด ${fmtMoney(stats.min)} · สูงสุด ${fmtMoney(stats.max)} / ${esc(i.unit)}</span>
    </div>`;
  }).filter(Boolean).join('') || `<div class="muted" style="padding:6px 2px;">ยังไม่มีข้อมูลราคา</div>`;

  /* ---- purchase dashboard stats (period-aware) ---- */
  const period = purchaseDashPeriod;
  const periodLabels = {day:'วันนี้', month:'เดือนนี้', year:'ปีนี้', all:'ทั้งหมด'};
  const periodPurchases = DB.purchases.filter(p=>periodPredicate(period, p.date));
  const prevPeriodPurchases = period==='all' ? [] : DB.purchases.filter(p=>prevPeriodPredicate(period, p.date));

  const totalCount = periodPurchases.length;
  const totalSpend = periodPurchases.reduce((s,p)=>s+p.price,0);
  const prevSpend = prevPeriodPurchases.reduce((s,p)=>s+p.price,0);
  const diffPct = prevSpend>0 ? ((totalSpend-prevSpend)/prevSpend*100) : null;
  const avgPurchase = totalCount>0 ? totalSpend/totalCount : 0;
  const lastPurchase = sorted[0];
  const distinctIngredientsInPeriod = new Set(periodPurchases.map(p=>p.ingredientId)).size;

  const spendByIngredient = {};
  periodPurchases.forEach(p=>{
    spendByIngredient[p.ingredientId] = (spendByIngredient[p.ingredientId]||0) + p.price;
  });
  const topIngredients = Object.entries(spendByIngredient)
    .map(([id,spend])=>({id, spend, ingr: ingrById(id)}))
    .filter(x=>x.ingr)
    .sort((a,b)=>b.spend-a.spend)
    .slice(0,5);
  const maxIngredientSpend = topIngredients.length ? topIngredients[0].spend : 0;

  const spendByCategory = {};
  periodPurchases.forEach(p=>{
    const ingr = ingrById(p.ingredientId);
    const cat = (ingr && ingr.category) ? ingr.category : 'ไม่ระบุหมวดหมู่';
    spendByCategory[cat] = (spendByCategory[cat]||0) + p.price;
  });
  const topCategories = Object.entries(spendByCategory).map(([cat,spend])=>({cat,spend})).sort((a,b)=>b.spend-a.spend);
  const maxCategorySpend = topCategories.length ? topCategories[0].spend : 0;

  const ingredientBars = topIngredients.map(x=>`
    <div class="bar-item">
      <div class="bar-item-top"><span class="name">${esc(x.ingr.name)}</span><span class="val">${fmtMoney(x.spend)}</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${maxIngredientSpend?(x.spend/maxIngredientSpend*100):0}%"></div></div>
    </div>`).join('') || `<div class="muted" style="padding:6px 2px;">ไม่มีข้อมูลการซื้อในช่วง${periodLabels[period]}</div>`;

  const categoryBars = topCategories.map(x=>`
    <div class="bar-item">
      <div class="bar-item-top"><span class="name">${esc(x.cat)}</span><span class="val">${fmtMoney(x.spend)}</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${maxCategorySpend?(x.spend/maxCategorySpend*100):0}%"></div></div>
    </div>`).join('') || `<div class="muted" style="padding:6px 2px;">ไม่มีข้อมูลการซื้อในช่วง${periodLabels[period]}</div>`;

  const tabs = ['day','month','year','all'].map(p=>
    `<button class="seg-tab ${period===p?'active':''}" onclick="setPurchaseDashPeriod('${p}')">${periodLabels[p]}</button>`
  ).join('');

  const thirdCard = period==='all'
    ? `<div class="stat-card" style="--accent:var(--chili)"><div class="stat-label">วัตถุดิบที่เคยซื้อ</div><div class="stat-value">${fmtNum(distinctIngredientsInPeriod)}</div><div class="stat-note">ชนิดวัตถุดิบที่มีประวัติการซื้อ</div></div>`
    : `<div class="stat-card" style="--accent:var(--chili)"><div class="stat-label">ยอดซื้อ${periodLabels[period]}</div><div class="stat-value">${fmtMoney(totalSpend)}</div><div class="stat-note">${diffPct===null?`ยังไม่มีข้อมูลช่วงก่อนหน้าเทียบ`:(diffPct>=0?`▲ เพิ่มขึ้น ${fmtNum(diffPct,1)}% จากช่วงก่อนหน้า`:`▼ ลดลง ${fmtNum(Math.abs(diffPct),1)}% จากช่วงก่อนหน้า`)}</div></div>`;

  document.getElementById('page-purchases').innerHTML = `
    <div class="page-head">
      <div><h1 class="page-title">🛒 การซื้อ</h1><p class="page-desc">บันทึกประวัติการซื้อวัตถุดิบทุกครั้ง เพื่อคำนวณราคาล่าสุดและราคาเฉลี่ย</p></div>
      <div class="page-actions"><button class="btn btn-accent" onclick="openPurchaseModal()">+ บันทึกการซื้อ</button></div>
    </div>

    <div class="dash-toolbar">
      <div class="seg-tabs">${tabs}</div>
      <div class="range-label">แสดงข้อมูลสรุป: ${periodLabels[period]}</div>
    </div>

    <div class="cards-row">
      <div class="stat-card" style="--accent:var(--turmeric)"><div class="stat-label">จำนวนรายการซื้อ</div><div class="stat-value">${fmtNum(totalCount)}</div><div class="stat-note">${lastPurchase?`ซื้อล่าสุด ${fmtDate(lastPurchase.date)}`:'ยังไม่มีรายการ'}</div></div>
      <div class="stat-card" style="--accent:var(--clay)"><div class="stat-label">ยอดซื้อรวม (${periodLabels[period]})</div><div class="stat-value">${fmtMoney(totalSpend)}</div><div class="stat-note">บาท ทุกวัตถุดิบรวมกัน</div></div>
      ${thirdCard}
      <div class="stat-card" style="--accent:var(--herb)"><div class="stat-label">ราคาเฉลี่ยต่อรายการซื้อ</div><div class="stat-value">${fmtMoney(avgPurchase)}</div><div class="stat-note">บาท ต่อการซื้อ 1 ครั้ง</div></div>
    </div>

    <div class="two-col">
      <div class="panel">
        <div class="panel-title">ซื้อมากที่สุด (ตามยอดใช้จ่าย) <small>Top 5 วัตถุดิบ · ${periodLabels[period]}</small></div>
        ${ingredientBars}
      </div>
      <div class="panel">
        <div class="panel-title">ยอดซื้อตามหมวดหมู่ <small>${periodLabels[period]}</small></div>
        ${categoryBars}
      </div>
    </div>

    <div class="panel">
      <div class="panel-title">สรุปราคาต่อวัตถุดิบ <small>จากประวัติการซื้อทั้งหมด</small></div>
      <div class="mini-list">${summary}</div>
    </div>
    <div class="panel">
      <div class="panel-title">ประวัติการซื้อ <small>${filtered.length!==sorted.length?`พบ ${fmtNum(filtered.length)} จากทั้งหมด ${fmtNum(sorted.length)} รายการ`:`ทั้งหมด ${fmtNum(sorted.length)} รายการ`}</small></div>
      <div class="toolbar">
        <div class="search-box"><span class="ic">🔎</span><input id="purchaseSearch" placeholder="ค้นหาชื่อวัตถุดิบ หรือหมายเหตุ..." value="${esc(purchaseFilter.q)}"></div>
        <select class="filter-select" id="purchaseCatFilter">
          <option value="">ทุกหมวดหมู่</option>
          ${purchaseCats.map(c=>`<option value="${esc(c)}" ${purchaseFilter.cat===c?'selected':''}>${esc(c)}</option>`).join('')}
        </select>
      </div>
      <div class="table-scroll"><table class="data-table">
        <thead><tr><th>วันที่</th><th>วัตถุดิบ</th><th>จำนวน</th><th>ราคารวม</th><th>ราคาต่อหน่วย</th><th>หมายเหตุ</th><th>จัดการ</th></tr></thead>
        <tbody>${rows}</tbody>
      </table></div>
    </div>
  `;
  document.getElementById('purchaseSearch').addEventListener('input', e=>{ purchaseFilter.q=e.target.value; RENDERERS.purchases(); });
  document.getElementById('purchaseCatFilter').addEventListener('change', e=>{ purchaseFilter.cat=e.target.value; RENDERERS.purchases(); });
};
function openPurchaseModal(id){
  if(DB.ingredients.length===0){ toast('กรุณาเพิ่มวัตถุดิบก่อน'); return; }
  const p = id ? DB.purchases.find(x=>x.id===id) : null;
  openModal(p?'แก้ไขรายการซื้อ':'บันทึกการซื้อวัตถุดิบ', `
    <div class="form-grid">
      <div class="field span-2"><label>วัตถุดิบ</label>
        <select id="f_ingredient">${DB.ingredients.map(i=>`<option value="${i.id}" ${p&&p.ingredientId===i.id?'selected':''}>${esc(i.name)} (${esc(i.unit)})</option>`).join('')}</select>
      </div>
      <div class="field"><label>วันที่ซื้อ</label><input id="f_date" type="date" value="${p?p.date:todayStr()}"></div>
      <div class="field"><label>จำนวน (หน่วยมาตรฐาน)</label><input id="f_qty" type="number" step="0.01" placeholder="เช่น 1" value="${p?p.qty:''}"></div>
      <div class="field"><label>ราคารวม (บาท)</label><input id="f_price" type="number" step="0.01" placeholder="เช่น 80" value="${p?p.price:''}"></div>
      <div class="field"><label>ราคาต่อหน่วย</label><input id="f_ppu" disabled placeholder="คำนวณอัตโนมัติ" value="${p?fmtMoney(p.pricePerUnit):''}"></div>
      <div class="field span-2"><label>หมายเหตุ</label><input id="f_note" placeholder="ไม่บังคับ" value="${p?esc(p.note||''):''}"></div>
    </div>
    ${p?`<div class="hint" style="margin-top:2px;color:var(--ink-faint);font-size:12px;">💡 การแก้ไขจะปรับ Stock ให้ถูกต้องอัตโนมัติ (ระบบจะไม่ยอมบันทึกถ้าทำให้ Stock ติดลบ)</div>`:''}
    <div class="modal-foot">
      <button class="btn" onclick="closeModal()">ยกเลิก</button>
      <button class="btn btn-primary" onclick="savePurchase('${p?p.id:''}')">${p?'บันทึกการแก้ไข':'บันทึกการซื้อ'}</button>
    </div>
  `);
  const upd = ()=>{
    const q = Number(document.getElementById('f_qty').value)||0;
    const pr = Number(document.getElementById('f_price').value)||0;
    document.getElementById('f_ppu').value = q>0 ? fmtMoney(pr/q) : '';
  };
  document.getElementById('f_qty').addEventListener('input', upd);
  document.getElementById('f_price').addEventListener('input', upd);
}
function savePurchase(id){
  const ingredientId = document.getElementById('f_ingredient').value;
  const date = document.getElementById('f_date').value || todayStr();
  const qty = Number(document.getElementById('f_qty').value);
  const price = Number(document.getElementById('f_price').value);
  const note = document.getElementById('f_note').value.trim();
  if(!qty || qty<=0 || !price || price<=0){ toast('กรุณากรอกจำนวนและราคาให้ถูกต้อง'); return; }

  if(id){
    /* ---------- โหมดแก้ไข: ต้องปรับ Stock ให้ถูกต้อง และห้ามทำให้ Stock ติดลบ ---------- */
    const old = DB.purchases.find(x=>x.id===id);
    if(!old){ toast('ไม่พบรายการซื้อนี้'); return; }
    const oldIngredientId = old.ingredientId;

    if(oldIngredientId===ingredientId){
      // วัตถุดิบเดิม: ตรวจว่าถ้าเปลี่ยนจำนวนซื้อ (เอาของเก่าออก ใส่ของใหม่เข้า) แล้ว stock จะติดลบไหม
      const currentStock = getStock(oldIngredientId);
      const stockAfterChange = currentStock - old.qty + qty;
      if(stockAfterChange < -1e-9){
        const ingr = ingrById(oldIngredientId);
        toast(`ไม่สามารถบันทึกได้: การแก้ไขนี้จะทำให้ Stock ของ "${ingr?ingr.name:''}" ติดลบ (${fmtNum(stockAfterChange,2)} ${ingr?ingr.unit:''})`);
        return;
      }
    } else {
      // เปลี่ยนวัตถุดิบ: ต้องเอาของเดิมออกจากวัตถุดิบเก่า (ห้ามติดลบ) แล้วเพิ่มของใหม่เข้าวัตถุดิบใหม่
      const oldStockAfterRemove = getStock(oldIngredientId) - old.qty;
      if(oldStockAfterRemove < -1e-9){
        const ingr = ingrById(oldIngredientId);
        toast(`ไม่สามารถบันทึกได้: การย้ายรายการนี้ไปวัตถุดิบอื่นจะทำให้ Stock ของ "${ingr?ingr.name:''}" ติดลบ (${fmtNum(oldStockAfterRemove,2)} ${ingr?ingr.unit:''})`);
        return;
      }
    }

    Object.assign(old, {ingredientId, date, qty, price, pricePerUnit: price/qty, note});
    save('purchases');
    // ลบ stock movement เดิมของรายการซื้อนี้ แล้วสร้างใหม่ตามค่าที่แก้ไข
    DB.stockMovements = DB.stockMovements.filter(m=>m.ref!==id);
    addStockMovement(ingredientId, 'in', qty, 'รับเข้าจากการซื้อ (แก้ไข)', id, date);
    recomputeIngredientPricing(oldIngredientId);
    if(oldIngredientId!==ingredientId) recomputeIngredientPricing(ingredientId);
    closeModal();
    toast('แก้ไขรายการซื้อแล้ว และปรับ Stock ให้ถูกต้อง');
    RENDERERS.purchases();
    return;
  }

  const p = {id:uid(), ingredientId, date, qty, price, pricePerUnit: price/qty, note};
  DB.purchases.push(p);
  save('purchases');
  addStockMovement(ingredientId, 'in', qty, 'รับเข้าจากการซื้อ', p.id, date);
  recomputeIngredientPricing(ingredientId);
  closeModal();
  toast('บันทึกการซื้อแล้ว และเพิ่ม Stock อัตโนมัติ');
  RENDERERS.purchases();
};
function deletePurchase(id){
  const p = DB.purchases.find(x=>x.id===id);
  if(!p){ return; }
  const ingr = ingrById(p.ingredientId);
  // ลบ purchase = ย้อน stock (เอา movement 'in' ของรายการนี้ออก) ต้องเช็คก่อนว่าจะไม่ทำให้ stock ปัจจุบันติดลบ
  // เช่น ถ้าของล็อตนี้ถูกขาย/เบิกไปใช้แล้วบางส่วน stock คงเหลือปัจจุบันอาจน้อยกว่า qty ที่จะถูกย้อน
  const currentStock = getStock(p.ingredientId);
  const stockAfterUndo = currentStock - p.qty;
  if(stockAfterUndo < -1e-9){
    toast(`ไม่สามารถลบได้: การย้อน Stock ของ "${ingr?ingr.name:''}" จากรายการนี้จะทำให้ Stock ติดลบ (${fmtNum(stockAfterUndo,2)} ${ingr?ingr.unit:''}) เพราะวัตถุดิบล็อตนี้ถูกใช้ไปแล้วบางส่วน`);
    return;
  }
  if(!confirm('ลบประวัติการซื้อนี้? Stock ที่เพิ่มจากรายการนี้จะถูกปรับกลับด้วย')) return;
  DB.purchases = DB.purchases.filter(x=>x.id!==id);
  save('purchases');
  DB.stockMovements = DB.stockMovements.filter(m=>m.ref!==id);
  save('stockMovements');
  recomputeIngredientPricing(p.ingredientId);
  toast('ลบประวัติการซื้อแล้ว และย้อน Stock เรียบร้อย');
  RENDERERS.purchases();
}

/* =========================================================
   STOCK
   ========================================================= */
let stockFilter = {q:''};
RENDERERS.stock = function(){
  const sortedIngr = [...DB.ingredients];
  const filteredIngr = sortedIngr.filter(i=>{
    if(!stockFilter.q) return true;
    const q = stockFilter.q.toLowerCase();
    const hay = `${i.name} ${i.category||''}`.toLowerCase();
    return hay.includes(q);
  });
  const rows = filteredIngr.map(i=>{
    const stock = getStock(i.id);
    return `<tr>
      <td class="cell-strong">${esc(i.name)}<div class="cell-sub">${esc(i.category||'-')}</div></td>
      <td class="num">${fmtNum(stock,2)} ${esc(i.unit)}</td>
      <td class="num">${fmtNum(i.minStock,2)} ${esc(i.unit)}</td>
      <td class="num">${statusBadge(stockStatusOf(i.id))}</td>
      <td><div class="row-actions">
        <button class="btn btn-sm" onclick="openStockMoveModal('${i.id}','in')">รับเข้า</button>
        <button class="btn btn-sm" onclick="openStockMoveModal('${i.id}','out')">เบิกออก</button>
        <button class="btn btn-sm" onclick="openStockMoveModal('${i.id}','adjust')">ปรับยอด</button>
      </div></td>
    </tr>`;
  }).join('') || `<tr class="empty-row"><td colspan="5">${sortedIngr.length===0?'ยังไม่มีวัตถุดิบ':'ไม่พบวัตถุดิบที่ตรงกับการค้นหา'}</td></tr>`;

  const moves = [...DB.stockMovements].sort((a,b)=> a.date<b.date?1:-1).slice(0,40).map(m=>{
    const ingr = ingrById(m.ingredientId);
    const typeLabel = {in:'รับเข้า',out:'เบิกออก',adjust:'ปรับยอด'}[m.type]||m.type;
    return `<tr>
      <td>${fmtDate(m.date)}</td>
      <td class="cell-strong">${ingr?esc(ingr.name):'(ลบแล้ว)'}</td>
      <td><span class="tag-pill">${typeLabel}</span></td>
      <td class="num" style="color:${m.qty>=0?'var(--good)':'var(--danger)'};font-weight:600;">${m.qty>=0?'+':''}${fmtNum(m.qty,2)}</td>
      <td>${esc(m.note||'-')}</td>
    </tr>`;
  }).join('') || `<tr class="empty-row"><td colspan="5">ยังไม่มีความเคลื่อนไหว Stock</td></tr>`;

  document.getElementById('page-stock').innerHTML = `
    <div class="page-head">
      <div><h1 class="page-title">📦 Stock</h1><p class="page-desc">ยอด Stock ปัจจุบัน คำนวณจากประวัติการเคลื่อนไหวทั้งหมด (ห้ามแก้โดยไม่มีประวัติ)</p></div>
    </div>
    <div class="panel">
      <div class="toolbar">
        <div class="search-box"><span class="ic">🔎</span><input id="stockSearch" placeholder="ค้นหาวัตถุดิบ หรือหมวดหมู่..." value="${esc(stockFilter.q)}"></div>
      </div>
      <div class="table-scroll"><table class="data-table">
        <thead><tr><th>วัตถุดิบ</th><th>Stock ปัจจุบัน</th><th>Minimum Stock</th><th>สถานะ</th><th>จัดการ</th></tr></thead>
        <tbody>${rows}</tbody>
      </table></div>
    </div>
    <div class="panel">
