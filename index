function openStockMoveModal(ingredientId, type){
  const ingr = ingrById(ingredientId);
  const current = getStock(ingredientId);
  const titleMap = {in:'บันทึกรับเข้า Stock', out:'บันทึกเบิกออก Stock', adjust:'ปรับยอด Stock (นับจริง)'};
  openModal(titleMap[type], `
    <div class="panel" style="margin:0 0 14px;padding:12px 14px;background:var(--surface-2);">
      <div class="kv-line"><span>วัตถุดิบ</span><b>${esc(ingr.name)}</b></div>
      <div class="kv-line"><span>Stock ปัจจุบัน</span><b>${fmtNum(current,2)} ${esc(ingr.unit)}</b></div>
    </div>
    <div class="form-grid cols-1">
      <div class="field"><label>วันที่</label><input id="f_date" type="date" value="${todayStr()}"></div>
      <div class="field"><label>${type==='adjust'?`นับยอดจริง (${esc(ingr.unit)})`:`จำนวน (${esc(ingr.unit)})`}</label><input id="f_qty" type="number" step="0.01" placeholder="0"></div>
      <div class="field"><label>หมายเหตุ / เหตุผล</label><input id="f_note" placeholder="${type==='adjust'?'เช่น นับสต๊อกประจำวัน พบของเสีย':'เช่น เบิกไปใช้ทำเมนูพิเศษ'}"></div>
    </div>
    <div class="modal-foot">
      <button class="btn" onclick="closeModal()">ยกเลิก</button>
      <button class="btn btn-primary" onclick="saveStockMove('${ingredientId}','${type}')">บันทึก</button>
    </div>
  `);
}
function saveStockMove(ingredientId, type){
  const date = document.getElementById('f_date').value || todayStr();
  const val = Number(document.getElementById('f_qty').value);
  const note = document.getElementById('f_note').value.trim();
  if(val===undefined || isNaN(val) || val<0){ toast('กรุณากรอกจำนวนเป็นตัวเลขที่ไม่ติดลบ'); return; }
  const current = getStock(ingredientId);
  let delta;
  if(type==='in') delta = Math.abs(val);
  else if(type==='out') delta = -Math.abs(val);
  else { // adjust: val is the counted absolute stock
    delta = val - current;
  }
  const resultStock = current + delta;
  // ป้องกัน Stock ติดลบทุกกรณี (เบิกออกเกินที่มี หรือปรับยอดเป็นค่าติดลบไม่ได้อยู่แล้วเพราะเช็ค val<0 ด้านบน)
  if(resultStock < -1e-9){
    const ingr = ingrById(ingredientId);
    toast(`ไม่สามารถบันทึกได้: Stock ของ "${ingr?ingr.name:''}" จะติดลบ (${fmtNum(resultStock,2)} ${ingr?ingr.unit:''}) — มีอยู่ ${fmtNum(current,2)} ${ingr?ingr.unit:''}`);
    return;
  }
  if(delta===0){ toast('ไม่มีการเปลี่ยนแปลง Stock'); closeModal(); return; }
  addStockMovement(ingredientId, type, delta, note || (type==='adjust'?'ปรับยอดจากการนับจริง':''), null, date);
  closeModal();
  toast('บันทึก Stock แล้ว');
  RENDERERS.stock();
}

