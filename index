      <table><thead><tr><th>เมนู</th><th style="text-align:center">จำนวน</th><th style="text-align:center">ยอดขาย</th><th style="text-align:center">Food Cost</th><th style="text-align:center">กำไร</th></tr></thead>
      <tbody>${recipeRows}</tbody></table>
      <p style="margin-top:24px;color:#9C9080;font-size:11px;">พิมพ์จากระบบ Food Cost & Profit Manager เมื่อ ${fmtDate(todayStr())}</p>
