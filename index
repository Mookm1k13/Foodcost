/* ---------------- Utilities ---------------- */
function uid(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,7); }
function todayStr(){ return new Date().toISOString().slice(0,10); }
function fmtDate(d){
  if(!d) return '-';
  const dt = new Date(d+'T00:00:00');
  if(isNaN(dt)) return d;
  return dt.toLocaleDateString('th-TH',{day:'2-digit',month:'2-digit',year:'numeric'});
}
function fmtMoney(n){
  n = Number(n)||0;
  return n.toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});
}
function fmtNum(n, d){
  n = Number(n)||0;
  return n.toLocaleString('th-TH',{minimumFractionDigits:d||0,maximumFractionDigits:d===undefined?2:d});
}
function esc(s){
  return String(s==null?'':s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function toast(msg){
  const wrap = document.getElementById('toastWrap');
  const el = document.createElement('div');
  el.className='toast';
  el.textContent = msg;
  wrap.appendChild(el);
  setTimeout(()=>{ el.style.transition='opacity .25s'; el.style.opacity='0'; setTimeout(()=>el.remove(),250); }, 2200);
}

/* ---------------- Unit conversion ---------------- */
const WEIGHT_UNITS = {g:1, kg:1000};
const VOLUME_UNITS = {ml:1, l:1000};
const COMMON_UNITS = ['kg','g','l','ml','ฟอง','ใบ','ชิ้น','กล่อง','ก้อน','ช้อนโต๊ะ','ช้อนชา','แผ่น','ลูก','หัว','ต้น','กำ','ขวด','ถุง'];
function unitGroup(u){
  if(WEIGHT_UNITS[u]!==undefined) return 'weight';
  if(VOLUME_UNITS[u]!==undefined) return 'volume';
  return 'count:'+u;
}
// returns converted qty in toUnit, or null if incompatible
function convertQty(qty, fromUnit, toUnit){
  if(fromUnit===toUnit) return qty;
  if(WEIGHT_UNITS[fromUnit]!==undefined && WEIGHT_UNITS[toUnit]!==undefined){
    return qty*WEIGHT_UNITS[fromUnit]/WEIGHT_UNITS[toUnit];
  }
  if(VOLUME_UNITS[fromUnit]!==undefined && VOLUME_UNITS[toUnit]!==undefined){
    return qty*VOLUME_UNITS[fromUnit]/VOLUME_UNITS[toUnit];
  }
  return null;
}
function unitDatalist(){
  return `<datalist id="unitList">${COMMON_UNITS.map(u=>`<option value="${u}">`).join('')}</datalist>`;
}

/* ---------------- Storage ---------------- */
const DB_KEYS = ['ingredients','purchases','stockMovements','recipes','platforms','promotions','sales','settings'];
function loadAll(){
  DB_KEYS.forEach(k=>{
    const raw = localStorage.getItem('fcpm_'+k);
    if(raw===null){
      DB[k] = k==='settings' ? {costMethod:'latest', fixedOverhead:[]} : [];
    } else {
      try{ DB[k] = JSON.parse(raw); } catch(e){ DB[k] = k==='settings'?{costMethod:'latest', fixedOverhead:[]}:[]; }
    }
  });
  // migration: older saved settings may not have fixedOverhead yet
  if(!DB.settings.fixedOverhead) DB.settings.fixedOverhead = [];
}
function save(key){
  localStorage.setItem('fcpm_'+key, JSON.stringify(DB[key]));
}
const DB = {};


function recomputeIngredientPricing(ingredientId, doSave){
  const list = DB.purchases.filter(p=>p.ingredientId===ingredientId).sort((a,b)=> a.date<b.date?-1:1);
  const ingr = DB.ingredients.find(i=>i.id===ingredientId);
  if(!ingr) return;
  if(list.length===0){ ingr.latestPrice=0; ingr.avgPrice=0; }
  else{
    ingr.latestPrice = list[list.length-1].pricePerUnit;
    const totalCost = list.reduce((s,p)=>s+p.price,0);
    const totalQty = list.reduce((s,p)=>s+p.qty,0);
    ingr.avgPrice = totalQty>0 ? totalCost/totalQty : 0;
  }
  if(doSave!==false) save('ingredients');
}
function purchaseStats(ingredientId){
  const list = DB.purchases.filter(p=>p.ingredientId===ingredientId);
  if(list.length===0) return {min:0,max:0,count:0};
  const prices = list.map(p=>p.pricePerUnit);
  return {min:Math.min(...prices), max:Math.max(...prices), count:list.length};
}
function getStock(ingredientId){
  return DB.stockMovements.filter(m=>m.ingredientId===ingredientId).reduce((s,m)=>s+m.qty,0);
}
function stockStatusOf(ingredientId){
  const ingr = DB.ingredients.find(i=>i.id===ingredientId);
  const stock = getStock(ingredientId);
  if(stock<=0) return 'danger';
  if(stock<= (ingr?ingr.minStock:0)) return 'warn';
  return 'good';
}
function statusBadge(status){
  const map = {
    good:{cls:'badge-good', text:'ปกติ', dot:'🟢'},
    warn:{cls:'badge-warn', text:'ใกล้หมด', dot:'🟡'},
    danger:{cls:'badge-danger', text:'หมด', dot:'🔴'}
  };
  const m = map[status];
  return `<span class="badge ${m.cls}"><span class="dot"></span>${m.text}</span>`;
}
function addStockMovement(ingredientId, type, qty, note, ref, date){
  DB.stockMovements.push({id:uid(), ingredientId, date: date||todayStr(), type, qty, note: note||'', ref: ref||null});
  save('stockMovements');
}
function ingrById(id){ return DB.ingredients.find(i=>i.id===id); }
function recipeById(id){ return DB.recipes.find(r=>r.id===id); }
function platformById(id){ return DB.platforms.find(p=>p.id===id); }
function promoById(id){ return DB.promotions.find(p=>p.id===id); }

/* ---------------- Fixed overhead / break-even ---------------- */
function totalMonthlyOverhead(){
  return (DB.settings.fixedOverhead||[]).reduce((s,x)=>s+(Number(x.amount)||0),0);
}
function daysInMonthOf(monthKey){ // 'YYYY-MM' -> number of days in that month
  const [y,mo] = monthKey.split('-').map(Number);
  return new Date(y, mo, 0).getDate();
}
function daysCountInRange(range){
  // นับจำนวนวันของช่วง ถ้าไม่มี start/end ชัดเจน (เช่นเลือก "ทั้งหมด") จะคืน null เพราะเฉลี่ยต้นทุนคงที่ไม่ได้
  if(!range.start || !range.end) return null;
  const s = new Date(range.start+'T00:00:00'), e = new Date(range.end+'T00:00:00');
  if(isNaN(s)||isNaN(e)) return null;
  return Math.round((e-s)/86400000)+1;
}

function computeRecipeCost(recipe){
  const method = DB.settings.costMethod || 'latest';
  let ingredientCost = 0;
  let hasUnitError = false;
  const lines = recipe.items.map(item=>{
    const ingr = ingrById(item.ingredientId);
    if(!ingr){ hasUnitError = true; return {name:'(ลบแล้ว)', qty:item.qty, unit:item.unit, cost:0, warn:true, warnReason:'ลบแล้ว'}; }
    const unitPrice = method==='latest' ? ingr.latestPrice : ingr.avgPrice;
    const converted = convertQty(item.qty, item.unit, ingr.unit);
    // หน่วยไม่ตรงกัน (แปลงไม่ได้) ต้องไม่ยอมคำนวณต้นทุนบรรทัดนี้ แทนที่จะเดาว่าหน่วยเท่ากัน
    if(converted===null){
      hasUnitError = true;
      return {name:ingr.name, qty:item.qty, unit:item.unit, unitPrice, cost:0, warn:true, warnReason:`หน่วย "${item.unit}" แปลงเป็น "${ingr.unit}" ไม่ได้`};
    }
    const cost = unitPrice * converted;
    ingredientCost += cost;
    return {name:ingr.name, qty:item.qty, unit:item.unit, unitPrice, cost, warn:false};
  });
  const otherCostItems = (recipe.otherCostItems && recipe.otherCostItems.length)
    ? recipe.otherCostItems
    : (Number(recipe.otherCost)>0 ? [{name:'ต้นทุนอื่นๆ', amount:Number(recipe.otherCost)}] : []);
  const otherCost = otherCostItems.reduce((s,x)=>s+(Number(x.amount)||0),0);
  // ถ้ามีบรรทัดที่คำนวณไม่ได้ ยอดรวมถือว่ายังไม่สมบูรณ์ (ไม่รวมต้นทุนของบรรทัดนั้น) และต้องแจ้งเตือนผู้ใช้เสมอ
  const total = ingredientCost + otherCost;
  return {lines, ingredientCost, otherCost, otherCostItems, total, hasUnitError};
}

function computeSaleFigures(recipeId, qty, platformId, promotionId, sellingPrice){
  const recipe = recipeById(recipeId);
  const platform = platformById(platformId);
  const promo = promotionId ? promoById(promotionId) : null;
  const rc = recipe ? computeRecipeCost(recipe) : {total:0};
  const foodCostUnit = rc.total;
  const foodCostTotal = foodCostUnit*qty;
  const gross = sellingPrice*qty;
  const platformFeeAmt = platform ? gross*(Number(platform.feePercent)||0)/100 : 0;
  const paymentFeeAmt = platform ? gross*(Number(platform.paymentFeePercent)||0)/100 : 0;
  const otherFeeAmt = platform ? (Number(platform.otherFee)||0) : 0;
  let promoDiscountTotal = 0, promoStoreShare = 0;
  if(promo){
    const unitDiscount = promo.type==='percent' ? sellingPrice*(Number(promo.value)||0)/100 : (Number(promo.value)||0);
    promoDiscountTotal = unitDiscount*qty;
    if(promo.responsibility==='store') promoStoreShare = promoDiscountTotal;
    else if(promo.responsibility==='platform') promoStoreShare = 0;
    else promoStoreShare = promoDiscountTotal*((Number(promo.splitStorePercent)||0)/100);
  }
  const netRevenue = gross - platformFeeAmt - paymentFeeAmt - otherFeeAmt - promoStoreShare;
  const actualProfit = netRevenue - foodCostTotal;
  const profitMargin = gross>0 ? (actualProfit/gross*100) : 0;
  return {recipe, platform, promo, foodCostUnit, foodCostTotal, gross, platformFeeAmt, paymentFeeAmt, otherFeeAmt,
           promoDiscountTotal, promoStoreShare, netRevenue, actualProfit, profitMargin};
}

function checkSaleStock(recipeId, qty, excludeRef){
  // ---- ตรวจสอบก่อนบันทึกจริง: ห้ามคำนวณ/ตัด stock ถ้าหน่วยไม่ตรง และห้าม stock ติดลบ ----
  // excludeRef: ถ้าระบุ จะไม่นับ stock movement ของ sale นี้ (ใช้ตอนแก้ไขรายการขายเดิม)
  const recipe = recipeById(recipeId);
  if(!recipe) return {success:true, recipe:null};

  const usage = []; // {ingr, totalUse}
  for(const item of recipe.items){
    const ingr = ingrById(item.ingredientId);
    if(!ingr){
      return {success:false, error:`ไม่สามารถบันทึกการขายได้: พบวัตถุดิบที่ถูกลบไปแล้วในสูตร "${recipe.name}"`};
    }
    const converted = convertQty(item.qty, item.unit, ingr.unit);
    if(converted===null){
      return {success:false, error:`ไม่สามารถบันทึกการขายได้: หน่วย "${item.unit}" ของ "${ingr.name}" ในสูตรแปลงเป็นหน่วยสต๊อก "${ingr.unit}" ไม่ได้ กรุณาแก้ไขหน่วยในสูตรก่อน`};
    }
    const totalUse = converted*qty;
    usage.push({ingr, totalUse});
  }
  // รวมยอดใช้ต่อวัตถุดิบ (เผื่อวัตถุดิบซ้ำกันหลายบรรทัดในสูตรเดียว) แล้วเช็ค stock พร้อมกันทั้งหมดก่อนตัดจริง
  const usageByIngr = {};
  usage.forEach(u=>{ usageByIngr[u.ingr.id] = (usageByIngr[u.ingr.id]||0) + u.totalUse; });
  for(const ingrId in usageByIngr){
    const ingr = ingrById(ingrId);
    let currentStock = getStock(ingrId);
    if(excludeRef){
      // เอา stock movement เดิมของรายการขายที่กำลังแก้ไขออกก่อน (คืนของเดิมกลับมาชั่วคราวเพื่อคำนวณ)
      const excluded = DB.stockMovements.filter(m=>m.ref===excludeRef && m.ingredientId===ingrId).reduce((s,m)=>s+m.qty,0);
      currentStock -= excluded;
    }
    const remaining = currentStock - usageByIngr[ingrId];
    if(remaining < -1e-9){
      return {success:false, error:`Stock "${ingr.name}" ไม่พอสำหรับการขายนี้ (มี ${fmtNum(currentStock,2)} ${ingr.unit}, ต้องใช้ ${fmtNum(usageByIngr[ingrId],2)} ${ingr.unit})`};
    }
  }
  return {success:true, recipe};
}

function recordSale(recipeId, qty, platformId, promotionId, sellingPrice, date, doSave){
  const check = checkSaleStock(recipeId, qty);
  if(!check.success) return check;
  const recipe = check.recipe;

  const f = computeSaleFigures(recipeId, qty, platformId, promotionId, sellingPrice);
  const sale = {
    id:uid(), date: date||todayStr(), recipeId, qty, platformId, promotionId: promotionId||null, sellingPrice,
    foodCostUnit:f.foodCostUnit, foodCostTotal:f.foodCostTotal, gross:f.gross,
    platformFeeAmt:f.platformFeeAmt, paymentFeeAmt:f.paymentFeeAmt, otherFeeAmt:f.otherFeeAmt,
    promoDiscountTotal:f.promoDiscountTotal, promoStoreShare:f.promoStoreShare,
    netRevenue:f.netRevenue, actualProfit:f.actualProfit, profitMargin:f.profitMargin
  };
  DB.sales.push(sale);
  // deduct stock (ผ่านการตรวจสอบแล้วด้านบนว่าหน่วยตรงกันและ stock พอ)
  if(recipe){
    recipe.items.forEach(item=>{
      const ingr = ingrById(item.ingredientId);
      if(!ingr) return;
      const converted = convertQty(item.qty, item.unit, ingr.unit);
      const totalUse = converted*qty;
      addStockMovement(ingr.id, 'out', -totalUse, `ขาย: ${recipe.name} x${qty}`, sale.id, sale.date);
    });
  }
  if(doSave!==false){ save('sales'); }
  return {success:true, sale};
}

function updateSale(id, recipeId, qty, platformId, promotionId, sellingPrice, date){
  const old = DB.sales.find(s=>s.id===id);
  if(!old) return {success:false, error:'ไม่พบรายการขายนี้'};

  const check = checkSaleStock(recipeId, qty, id);
  if(!check.success) return check;
  const recipe = check.recipe;

  const f = computeSaleFigures(recipeId, qty, platformId, promotionId, sellingPrice);
  Object.assign(old, {
    date: date||old.date, recipeId, qty, platformId, promotionId: promotionId||null, sellingPrice,
    foodCostUnit:f.foodCostUnit, foodCostTotal:f.foodCostTotal, gross:f.gross,
    platformFeeAmt:f.platformFeeAmt, paymentFeeAmt:f.paymentFeeAmt, otherFeeAmt:f.otherFeeAmt,
    promoDiscountTotal:f.promoDiscountTotal, promoStoreShare:f.promoStoreShare,
    netRevenue:f.netRevenue, actualProfit:f.actualProfit, profitMargin:f.profitMargin
  });
  save('sales');

  // ลบ stock movement เดิมของรายการขายนี้ทั้งหมด แล้วสร้างใหม่ตามสูตร/จำนวนที่แก้ไข
  DB.stockMovements = DB.stockMovements.filter(m=>m.ref!==id);
  if(recipe){
    recipe.items.forEach(item=>{
      const ingr = ingrById(item.ingredientId);
      if(!ingr) return;
      const converted = convertQty(item.qty, item.unit, ingr.unit);
      const totalUse = converted*qty;
      addStockMovement(ingr.id, 'out', -totalUse, `ขาย: ${recipe.name} x${qty} (แก้ไข)`, id, old.date);
    });
  } else {
    save('stockMovements');
  }
  return {success:true, sale:old};
}

function deleteSale(id){
  const s = DB.sales.find(x=>x.id===id);
  if(!s){ return; }
  // ลบรายการขาย = คืน stock ที่เคยตัดไป (ลบ movement 'out' ของรายการนี้) ซึ่งทำให้ stock เพิ่มขึ้นเสมอ ไม่มีทางติดลบ
  if(!confirm('ลบประวัติการขายนี้? Stock ที่ตัดไปจากรายการนี้จะถูกคืนกลับให้ถูกต้อง')) return;
  DB.sales = DB.sales.filter(x=>x.id!==id);
  save('sales');
  DB.stockMovements = DB.stockMovements.filter(m=>m.ref!==id);
  save('stockMovements');
  toast('ลบประวัติการขายแล้ว และคืน Stock เรียบร้อย');
  RENDERERS.pricing();
}

