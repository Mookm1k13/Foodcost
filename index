function calcReversePrice(){
  const foodCost = Number(document.getElementById('r_foodcost').value)||0;
  const feePct = Number(document.getElementById('r_fee').value)||0;
  const promo = Number(document.getElementById('r_promo').value)||0;
  const targetProfit = Number(document.getElementById('r_profit').value)||0;
  const denom = 1-(feePct/100);
  const box = document.getElementById('r_result');
  if(denom<=0){
    box.innerHTML = `<div class="result-callout" style="border-color:var(--danger);"><div class="sub" style="color:var(--danger);">Platform Fee ต้องน้อยกว่า 100%</div></div>`;
    return;
  }
  const price = (targetProfit+foodCost+promo)/denom;
  const rounded = Math.ceil(price);
  box.innerHTML = `<div class="result-callout">
    <div class="big">${fmtMoney(price)} บาท</div>
    <div class="sub">ราคาขายขั้นต่ำที่ควรตั้ง — แนะนำตั้งราคา ${rounded} บาท</div>
  </div>`;
}

/* ---- ราคาขายแนะนำ ต่อช่องทาง (ตามเป้าหมายกำไร) ---- */
function updateSuggestedPrice(){
  const recipeId = document.getElementById('sg_recipe').value;
  const mode = document.getElementById('sg_mode').value;
  const target = Number(document.getElementById('sg_target').value)||0;
  const recipe = recipeById(recipeId);
  const box = document.getElementById('sg_result');
  if(!recipe){ box.innerHTML=''; return; }
  const rc = computeRecipeCost(recipe);
  if(rc.hasUnitError){
    box.innerHTML = `<div class="result-callout" style="border-color:var(--danger);"><div class="sub" style="color:var(--danger);font-weight:600;">⚠️ สูตรนี้มีวัตถุดิบหน่วยไม่ตรงกัน คำนวณราคาแนะนำไม่ได้ กรุณาแก้ไขหน่วยในสูตรก่อน</div></div>`;
    return;
  }
  const foodCost = rc.total;
  const computed = DB.platforms.map(pl=>{
    const feePct = (Number(pl.feePercent)||0) + (Number(pl.paymentFeePercent)||0);
    const otherFee = Number(pl.otherFee)||0;
    let price, errMsg=null;
    if(mode==='margin'){
      const denom = 1 - (feePct/100) - (target/100);
      if(denom<=0){ errMsg='ค่าธรรมเนียมรวมเป้าหมายกำไร ≥ 100%'; }
      else price = (foodCost + otherFee) / denom;
    } else {
      const denom = 1 - (feePct/100);
      if(denom<=0){ errMsg='ค่าธรรมเนียม ≥ 100%'; }
      else price = (foodCost + otherFee + target) / denom;
    }
    if(errMsg) return {pl, errMsg};
    const f = computeSaleFigures(recipeId, 1, pl.id, null, price);
    return {pl, price, f};
  });
  const valid = computed.filter(x=>!x.errMsg);
  const bestId = valid.length ? valid.reduce((a,b)=> b.f.actualProfit>a.f.actualProfit?b:a).pl.id : null;
  const tableRows = computed.map(x=>{
    if(x.errMsg) return `<tr><td class="cell-strong">${esc(x.pl.name)}</td><td colspan="4" style="color:var(--danger);">คำนวณไม่ได้ (${esc(x.errMsg)})</td></tr>`;
    return `<tr>
      <td class="cell-strong">${esc(x.pl.name)}${x.pl.id===bestId?' <span class="tag-pill" style="color:var(--good);border-color:var(--good-bg);">🏆 คุ้มที่สุด</span>':''}</td>
      <td class="num">${fmtMoney(x.price)}</td>
      <td class="num">${fmtMoney(x.f.netRevenue)}</td>
      <td class="num" style="font-weight:700;color:${x.f.actualProfit>=0?'var(--good)':'var(--danger)'}">${fmtMoney(x.f.actualProfit)}</td>
      <td class="num">${fmtNum(x.f.profitMargin,1)}%</td>
    </tr>`;
  }).join('') || `<tr class="empty-row"><td colspan="5">ยังไม่มีช่องทางขาย</td></tr>`;
  box.innerHTML = `
    <div class="hint" style="color:var(--ink-faint);font-size:12.5px;margin-bottom:8px;">Food Cost ต่อจาน: <strong>${fmtMoney(foodCost)}</strong> บาท — ราคาที่แต่ละช่องทางควรตั้ง เพื่อให้ได้กำไรตามเป้าหมายหลังหักค่าธรรมเนียมของช่องทางนั้น</div>
    <div class="table-scroll"><table class="data-table">
      <thead><tr><th>ช่องทาง</th><th>ราคาขายแนะนำ</th><th>Net Revenue</th><th>กำไร/จาน</th><th>Margin</th></tr></thead>
      <tbody>${tableRows}</tbody>
    </table></div>
  `;
}

/* ---- เปรียบเทียบกำไรของแต่ละ Platform ที่ราคาขายเดียวกัน ---- */
function updatePlatformCompare(){
  const recipeId = document.getElementById('sg_recipe').value;
  const price = Number(document.getElementById('cp_price').value)||0;
  const recipe = recipeById(recipeId);
  const box = document.getElementById('cp_result');
  if(!recipe || price<=0){
    box.innerHTML = `<div class="muted" style="padding:6px 2px;color:var(--ink-faint);font-size:13px;">กรอกราคาขายด้านบนเพื่อเปรียบเทียบกำไรของแต่ละช่องทาง</div>`;
    return;
  }
  const rc = computeRecipeCost(recipe);
  if(rc.hasUnitError){
    box.innerHTML = `<div class="result-callout" style="border-color:var(--danger);"><div class="sub" style="color:var(--danger);font-weight:600;">⚠️ สูตรนี้มีวัตถุดิบหน่วยไม่ตรงกัน คำนวณไม่ได้ กรุณาแก้ไขหน่วยในสูตรก่อน</div></div>`;
    return;
  }
  if(DB.platforms.length===0){ box.innerHTML = `<div class="muted" style="padding:6px 2px;color:var(--ink-faint);font-size:13px;">ยังไม่มีช่องทางขาย</div>`; return; }
  const results = DB.platforms.map(pl=> ({pl, f: computeSaleFigures(recipeId, 1, pl.id, null, price)}));
  const maxProfit = Math.max(...results.map(x=>x.f.actualProfit), 0);
  const minProfit = Math.min(...results.map(x=>x.f.actualProfit));
  box.innerHTML = results.map(x=>{
    const isBest = x.f.actualProfit===maxProfit && maxProfit>minProfit;
    const width = maxProfit>0 ? Math.max(0, x.f.actualProfit/maxProfit*100) : (x.f.actualProfit<0?0:100);
    return `<div class="bar-item">
      <div class="bar-item-top"><span class="name">${esc(x.pl.name)}${isBest?' 🏆':''}</span><span class="val" style="color:${x.f.actualProfit>=0?'var(--turmeric-deep)':'var(--danger)'}">${fmtMoney(x.f.actualProfit)} บาท · ${fmtNum(x.f.profitMargin,1)}%</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${width}%;${x.f.actualProfit<0?'background:var(--danger);':''}"></div></div>
    </div>`;
  }).join('');
}

/* ---- What-if Calculator ---- */
function updateWhatIf(){
  const recipeId = document.getElementById('wi_recipe').value;
  const price = Number(document.getElementById('wi_price').value)||0;
  const qty = Number(document.getElementById('wi_qty').value)||1;
  const platformId = document.getElementById('wi_platform').value;
  const costAdjPct = Number(document.getElementById('wi_costadj').value)||0;
  const feeAdjPct = Number(document.getElementById('wi_feeadj').value)||0;
  document.getElementById('wi_costadj_val').textContent = (costAdjPct>=0?'+':'')+costAdjPct+'%';
  document.getElementById('wi_feeadj_val').textContent = (feeAdjPct>=0?'+':'')+feeAdjPct+'%';

  const recipe = recipeById(recipeId);
  const platform = platformById(platformId);
  const box = document.getElementById('wi_result');
  if(!recipe || !platform || price<=0){
    box.innerHTML = `<div class="muted" style="padding:6px 2px;color:var(--ink-faint);font-size:13px;">กรอกราคาขายเพื่อเริ่มจำลองสถานการณ์</div>`;
    return;
  }
  const rc = computeRecipeCost(recipe);
  if(rc.hasUnitError){
    box.innerHTML = `<div class="result-callout" style="border-color:var(--danger);"><div class="sub" style="color:var(--danger);font-weight:600;">⚠️ สูตรนี้มีวัตถุดิบหน่วยไม่ตรงกัน คำนวณไม่ได้ กรุณาแก้ไขหน่วยในสูตรก่อน</div></div>`;
    return;
  }

  // Baseline: ราคา/จำนวน/ช่องทางที่เลือก โดยใช้ต้นทุนและค่าธรรมเนียมปกติ
  const baseline = computeSaleFigures(recipeId, qty, platformId, null, price);

  // What-if: ปรับต้นทุนวัตถุดิบและค่าธรรมเนียม platform ตามเปอร์เซ็นต์ที่ตั้ง
  const adjustedFoodCostUnit = rc.total * (1 + costAdjPct/100);
  const adjustedFeePct = Math.max(0, (Number(platform.feePercent)||0) * (1 + feeAdjPct/100));
  const gross = price*qty;
  const platformFeeAmt = gross*(adjustedFeePct/100);
  const paymentFeeAmt = gross*((Number(platform.paymentFeePercent)||0)/100);
  const otherFeeAmt = Number(platform.otherFee)||0;
  const foodCostTotal = adjustedFoodCostUnit*qty;
  const netRevenue = gross - platformFeeAmt - paymentFeeAmt - otherFeeAmt;
  const actualProfit = netRevenue - foodCostTotal;
  const profitMargin = gross>0 ? (actualProfit/gross*100) : 0;

  const deltaProfit = actualProfit - baseline.actualProfit;
  const deltaMargin = profitMargin - baseline.profitMargin;

  box.innerHTML = `
    <div class="two-col">
      <div class="calc-box">
        <div class="hint" style="font-weight:700;margin-bottom:6px;color:var(--ink-soft);">ปัจจุบัน (Baseline)</div>
        <div class="calc-row"><span>Food Cost รวม</span><span class="neg">-${fmtMoney(baseline.foodCostTotal)}</span></div>
        <div class="calc-row"><span>Platform Fee</span><span class="neg">-${fmtMoney(baseline.platformFeeAmt)}</span></div>
        <div class="calc-row"><span>Net Revenue</span><span>${fmtMoney(baseline.netRevenue)}</span></div>
        <div class="calc-row total"><span>กำไร</span><span style="color:${baseline.actualProfit>=0?'var(--good)':'var(--danger)'}">${fmtMoney(baseline.actualProfit)} บาท</span></div>
        <div class="calc-row"><span>Margin</span><span>${fmtNum(baseline.profitMargin,1)}%</span></div>
      </div>
      <div class="calc-box" style="border-color:var(--turmeric);border-style:solid;">
        <div class="hint" style="font-weight:700;margin-bottom:6px;color:var(--turmeric-deep);">What-if</div>
        <div class="calc-row"><span>Food Cost รวม</span><span class="neg">-${fmtMoney(foodCostTotal)}</span></div>
        <div class="calc-row"><span>Platform Fee</span><span class="neg">-${fmtMoney(platformFeeAmt)}</span></div>
