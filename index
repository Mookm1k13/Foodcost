<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Food Cost & Profit Manager</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@500;600;700&family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F7F0E2;
  --surface:#FFFCF5;
  --surface-2:#FBF5E9;
  --ink:#2A2420;
  --ink-soft:#6E6255;
  --ink-faint:#9C9080;
  --line:#E6D8BE;
  --line-soft:#EFE4CE;
  --rail:#2A231C;
  --rail-ink:#E9DFCC;
  --rail-ink-soft:#A99A83;
  --turmeric:#D9971F;
  --turmeric-deep:#B87A15;
  --chili:#C14A2B;
  --herb:#5C7A4E;
  --herb-deep:#3F5636;
  --clay:#8A5A3B;
  --danger:#B23B3B;
  --danger-bg:#F7E4DF;
  --warn:#B8791A;
  --warn-bg:#FAEBCF;
  --good:#3F6B3F;
  --good-bg:#E6EFDE;
  --shadow: 0 1px 0 rgba(42,36,32,0.04);
  --radius-s:6px;
  --radius-m:10px;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:'Sarabun',sans-serif;
  background:var(--bg);
  color:var(--ink);
  font-size:15px;
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,h4,.brand,.nav-label{font-family:'Kanit',sans-serif;}
button,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit;}
button{cursor:pointer;}
a{color:inherit;}
::selection{background:var(--turmeric);color:#fff;}

.app{
  display:grid;
  grid-template-columns:236px 1fr;
  min-height:100vh;
  min-width:0;
}

/* ---------- SIDEBAR ---------- */
.sidebar{
  background:var(--rail);
  color:var(--rail-ink);
  padding:22px 14px 18px;
  display:flex;
  flex-direction:column;
  position:sticky;
  top:0;
  height:100vh;
  overflow-y:auto;
}
.brand{
  display:flex;
  align-items:baseline;
  gap:8px;
  padding:0 8px 4px;
  margin-bottom:2px;
}
.brand-mark{
  width:9px;height:9px;border-radius:50%;
  background:var(--turmeric);
  flex:0 0 auto;
  transform:translateY(-1px);
}
.brand-text{font-weight:600;font-size:17px;color:#fff;letter-spacing:.2px;}
.brand-sub{
  padding:0 8px 22px;
  font-size:12px;
  color:var(--rail-ink-soft);
  border-bottom:1px solid rgba(233,223,204,0.12);
  margin-bottom:14px;
}
nav.navlist{display:flex;flex-direction:column;gap:2px;}
.nav-item{
  display:flex;
  align-items:center;
  gap:11px;
  padding:10px 12px;
  border-radius:8px;
  color:var(--rail-ink-soft);
  background:transparent;
  border:none;
  text-align:right;
  width:100%;
  font-size:14.5px;
  transition:background .12s ease, color .12s ease;
}
.nav-item .ic{font-size:16px;width:20px;text-align:center;flex:0 0 auto;}
.nav-item:hover{background:rgba(233,223,204,0.08);color:var(--rail-ink);}
.nav-item.active{
  background:rgba(217,151,31,0.16);
  color:#fff;
  box-shadow:inset 3px 0 0 var(--turmeric);
}
.sidebar-foot{
  margin-top:auto;
  padding:14px 10px 2px;
  font-size:11.5px;
  color:var(--rail-ink-soft);
  border-top:1px solid rgba(233,223,204,0.12);
  padding-top:14px;
}

/* ---------- MAIN ---------- */
main{padding:26px 34px 60px;max-width:1280px;min-width:0;}
.page{display:none;}
.page.active{display:block;animation:fadein .18s ease;}
@keyframes fadein{from{opacity:0;transform:translateY(3px);}to{opacity:1;transform:none;}}

.page-head{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  margin-bottom:22px;
  gap:16px;
  flex-wrap:wrap;
}
.page-title{font-size:23px;font-weight:600;margin:0 0 4px;display:flex;align-items:center;gap:10px;}
.page-desc{color:var(--ink-soft);font-size:13.5px;margin:0;}
.page-actions{display:flex;gap:10px;flex-wrap:wrap;}

/* buttons */
.btn{
  border:1px solid var(--line);
  background:var(--surface);
  padding:9px 15px;
  border-radius:8px;
  font-size:14px;
  font-weight:500;
  display:inline-flex;
  align-items:center;
  gap:7px;
  transition:border-color .12s, background .12s;
}
.btn:hover{border-color:var(--ink-faint);}
.btn-primary{
  background:var(--rail);
  color:#fff;
  border-color:var(--rail);
}
.btn-primary:hover{background:#3a3226;}
.btn-accent{background:var(--turmeric);border-color:var(--turmeric);color:#2A2420;font-weight:600;}
.btn-accent:hover{background:var(--turmeric-deep);}
.btn-danger{color:var(--danger);border-color:var(--danger-bg);background:var(--danger-bg);}
.btn-danger:hover{border-color:var(--danger);}
.btn-ghost{border-color:transparent;background:transparent;padding:7px 10px;}
.btn-ghost:hover{background:var(--surface-2);}
.btn-sm{padding:6px 11px;font-size:13px;border-radius:7px;}
.btn:disabled{opacity:.45;cursor:not-allowed;}

/* cards */
.cards-row{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:14px;
  margin-bottom:24px;
}
.stat-card{
  background:var(--surface);
  border:1px solid var(--line-soft);
  border-radius:var(--radius-m);
  padding:16px 18px;
  position:relative;
  overflow:hidden;
  box-shadow:var(--shadow);
}
.stat-card::before{
  content:"";
  position:absolute;left:0;top:0;bottom:0;width:4px;
  background:var(--accent,var(--turmeric));
}
.stat-card .stat-label{font-size:12.5px;color:var(--ink-soft);margin-bottom:6px;}
.stat-card .stat-value{font-size:23px;font-weight:600;font-family:'Kanit',sans-serif;}
.stat-card .stat-note{font-size:12px;color:var(--ink-faint);margin-top:4px;}

.panel{
  background:var(--surface);
  border:1px solid var(--line-soft);
  border-radius:var(--radius-m);
  padding:18px 20px 20px;
  margin-bottom:20px;
  box-shadow:var(--shadow);
  min-width:0;
}
.panel-title{font-size:15.5px;font-weight:600;margin:0 0 14px;display:flex;align-items:center;justify-content:space-between;gap:10px;}
.panel-title small{font-size:12px;font-weight:400;color:var(--ink-soft);}

/* toolbar */
.toolbar{
  display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap;
}
.search-box{
  display:flex;align-items:center;gap:7px;
  border:1px solid var(--line);border-radius:8px;
  padding:7px 12px;background:var(--surface-2);
  min-width:210px;flex:1 1 220px;
}
.search-box input{border:none;background:none;outline:none;width:100%;font-size:13.5px;}
.search-box .ic{color:var(--ink-faint);font-size:13px;}
select.filter-select{
  border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:var(--surface-2);font-size:13.5px;
}

/* table */
.table-scroll{
  width:100%;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  border:1px solid var(--line-soft);
  border-radius:var(--radius-m);
  background:var(--surface);
}
table.data-table{width:100%;border-collapse:collapse;font-size:13.8px;margin:0 auto;}
.data-table thead th{
  text-align:center;
  font-weight:600;
  color:var(--ink-soft);
  font-size:12.5px;
  padding:9px 12px;
  border-bottom:1.5px solid var(--line);
  white-space:nowrap;
  background:var(--surface-2);
}
.data-table thead th:first-child, .data-table tbody td:first-child{text-align:center;}
.data-table tbody td{padding:11px 12px;border-bottom:1px solid var(--line-soft);vertical-align:middle;white-space:nowrap;text-align:center;}
.data-table tbody tr:nth-child(even){background:rgba(42,36,32,0.018);}
.data-table tbody tr:hover{background:var(--surface-2);}
.data-table tbody tr:last-child td{border-bottom:none;}
.data-table .num{text-align:center;font-variant-numeric:tabular-nums;}
.data-table .row-actions{display:flex;gap:6px;justify-content:center;}
.data-table .cell-strong, .data-table td:first-child{white-space:normal;min-width:110px;}
.cell-strong{font-weight:600;}
.cell-sub{color:var(--ink-faint);font-size:12px;}
.empty-row td{text-align:center;color:var(--ink-faint);padding:34px 10px;font-size:13.5px;}

/* badges */
.badge{
  display:inline-flex;align-items:center;gap:5px;
  padding:3px 10px;border-radius:100px;font-size:12px;font-weight:600;white-space:nowrap;
}
.badge .dot{width:6px;height:6px;border-radius:50%;}
.badge-good{background:var(--good-bg);color:var(--good-deep,var(--good));}
.badge-good .dot{background:var(--good);}
.badge-warn{background:var(--warn-bg);color:#8a5c10;}
.badge-warn .dot{background:var(--warn);}
.badge-danger{background:var(--danger-bg);color:var(--danger);}
.badge-danger .dot{background:var(--danger);}
.badge-neutral{background:var(--surface-2);color:var(--ink-soft);border:1px solid var(--line);}

/* form */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 16px;}
.form-grid.cols-1{grid-template-columns:1fr;}
.form-grid.cols-3{grid-template-columns:1fr 1fr 1fr;}
.field{display:flex;flex-direction:column;gap:6px;}
.field.span-2{grid-column:span 2;}
.field label{font-size:12.8px;font-weight:600;color:var(--ink-soft);}
.field .hint{font-size:11.5px;color:var(--ink-faint);font-weight:400;}
.field input, .field select, .field textarea{
  border:1px solid var(--line);
  border-radius:8px;
  padding:9px 11px;
  background:var(--surface-2);
  outline:none;
  font-size:14px;
  width:100%;
}
.field input:focus, .field select:focus, .field textarea:focus{border-color:var(--turmeric);background:var(--surface);}
.field textarea{resize:vertical;min-height:64px;}
.radio-group{display:flex;gap:14px;flex-wrap:wrap;}
.radio-opt{display:flex;align-items:center;gap:6px;font-size:13.5px;}

/* modal */
.modal-overlay{
  position:fixed;inset:0;background:rgba(30,25,20,0.45);
  display:none;align-items:flex-start;justify-content:center;
  padding:5vh 16px;z-index:100;overflow-y:auto;
}
.modal-overlay.open{display:flex;}
.modal{
  background:var(--surface);
  border-radius:14px;
  width:100%;max-width:560px;
  padding:22px 24px 24px;
  box-shadow:0 20px 50px rgba(20,15,10,0.25);
  border:1px solid var(--line-soft);
}
.modal.wide{max-width:760px;}
.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.modal-head h3{margin:0;font-size:17px;font-weight:600;}
.modal-close{background:none;border:none;font-size:20px;color:var(--ink-faint);line-height:1;padding:4px;}
.modal-close:hover{color:var(--ink);}
.modal-foot{display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid var(--line-soft);}

/* recipe builder rows */
.line-rows{display:flex;flex-direction:column;gap:8px;margin-top:6px;}
.line-row{
  display:grid;grid-template-columns:1.6fr 0.7fr 0.7fr auto;gap:8px;align-items:center;
  background:var(--surface-2);padding:8px;border-radius:8px;border:1px solid var(--line-soft);
}
.line-row select, .line-row input{padding:7px 9px;font-size:13.5px;}
.line-row.cost-line-row{grid-template-columns:1.8fr 1fr auto;}
.add-line-btn{align-self:flex-start;}

/* calc summary box */
.calc-box{
  background:var(--surface-2);
  border:1px dashed var(--line);
  border-radius:10px;
  padding:14px 16px;
  margin-top:8px;
}
.calc-row{display:flex;justify-content:space-between;font-size:13.8px;padding:5px 0;}
.calc-row.total{border-top:1px solid var(--line);margin-top:6px;padding-top:10px;font-weight:700;font-size:15.5px;}
.calc-row .neg{color:var(--danger);}
.calc-row .pos{color:var(--good);}
.calc-row span:first-child{color:var(--ink-soft);}
.calc-row.total span:first-child{color:var(--ink);}

/* misc */
.two-col{display:grid;grid-template-columns:1.15fr 0.85fr;gap:18px;align-items:start;}
@media (max-width:980px){.two-col{grid-template-columns:1fr;}}
.tag-pill{
  display:inline-block;padding:2px 9px;border-radius:100px;font-size:11.5px;
  background:var(--surface-2);border:1px solid var(--line);color:var(--ink-soft);
}
.muted{color:var(--ink-faint);}
.mini-list{display:flex;flex-direction:column;gap:10px;}
.mini-list-item{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:var(--surface-2);border-radius:8px;border:1px solid var(--line-soft);}
.mini-list-item .name{font-weight:600;font-size:13.8px;}
.mini-list-item .val{font-family:'Kanit',sans-serif;font-weight:600;}
.bar-item{padding:8px 2px;}
.bar-item-top{display:flex;justify-content:space-between;font-size:13.2px;margin-bottom:6px;}
.bar-item-top .name{font-weight:600;}
.bar-item-top .val{font-family:'Kanit',sans-serif;font-weight:600;color:var(--turmeric-deep);}
.bar-track{height:7px;border-radius:100px;background:var(--surface-2);border:1px solid var(--line-soft);overflow:hidden;}
.bar-fill{height:100%;border-radius:100px;background:linear-gradient(90deg,var(--turmeric),var(--chili));}
.seg-tabs{display:inline-flex;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:3px;gap:2px;}
.seg-tab{border:none;background:none;padding:7px 15px;border-radius:7px;font-size:13.2px;font-weight:500;color:var(--ink-soft);white-space:nowrap;}
.seg-tab:hover:not(.active){background:rgba(42,36,32,0.06);}
.seg-tab.active{background:var(--rail);color:#fff;}
.dash-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:16px;}
.dash-toolbar .range-label{font-size:12.8px;color:var(--ink-soft);}
.toast-wrap{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);z-index:200;display:flex;flex-direction:column;gap:8px;align-items:center;}
.toast{background:var(--rail);color:#fff;padding:10px 18px;border-radius:100px;font-size:13.5px;box-shadow:0 8px 24px rgba(0,0,0,.25);animation:toastin .2s ease;}
@keyframes toastin{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}
.icon-btn{border:1px solid var(--line);background:var(--surface);width:30px;height:30px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-size:14px;}
.icon-btn:hover{border-color:var(--ink-faint);}
.kv-line{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--line-soft);font-size:13.5px;}
.kv-line:last-child{border-bottom:none;}
.kv-line b{font-family:'Kanit',sans-serif;}
.result-callout{
  background:linear-gradient(135deg, rgba(217,151,31,0.13), rgba(217,151,31,0.04));
  border:1px solid rgba(217,151,31,0.35);
  border-radius:12px;padding:18px 20px;text-align:center;margin-top:10px;
}
.result-callout .big{font-family:'Kanit',sans-serif;font-size:30px;font-weight:700;color:var(--turmeric-deep);}
.result-callout .sub{font-size:12.8px;color:var(--ink-soft);margin-top:4px;}

@media (max-width:860px){
  .app{grid-template-columns:1fr;grid-template-rows:auto 1fr;}
  .sidebar{
    position:sticky;top:0;height:auto;align-self:start;z-index:50;
    flex-direction:row;overflow-x:auto;overflow-y:hidden;
    padding:8px 10px;gap:0;align-items:center;
    scrollbar-width:none;
    box-shadow:0 2px 12px rgba(20,15,10,0.25);
  }
  .sidebar::-webkit-scrollbar{display:none;}
  .brand,.brand-sub,.sidebar-foot{display:none;}
  nav.navlist{flex-direction:row;gap:4px;margin:0 auto;}
  .nav-item{flex:0 0 auto;width:auto;white-space:nowrap;flex-direction:column;justify-content:center;text-align:center;gap:3px;padding:8px 12px;font-size:11.5px;line-height:1.3;}
  .nav-item.active{box-shadow:inset 0 3px 0 var(--turmeric);}
  main{padding:18px 16px 50px;}
  .form-grid, .form-grid.cols-3{grid-template-columns:1fr;}
  .field.span-2{grid-column:span 1;}
  .line-row{grid-template-columns:1fr;}
}

/* ---------- PHONE ---------- */
@media (max-width:640px){
  html{-webkit-text-size-adjust:100%;}
  .app{grid-template-columns:1fr;}
  main{padding:14px 12px 96px;max-width:100%;}

  /* bottom tab bar nav, thumb-reachable, horizontally scrollable */
  .sidebar{
    position:fixed;left:0;right:0;bottom:0;top:auto;height:auto;
    flex-direction:row;padding:5px 6px calc(5px + env(safe-area-inset-bottom));
    background:var(--rail);
    box-shadow:0 -3px 16px rgba(20,15,10,0.22);
    z-index:60;
  }
  nav.navlist{
    flex-direction:row;gap:2px;width:100%;
    overflow-x:auto;-webkit-overflow-scrolling:touch;
    scrollbar-width:none;
  }
  nav.navlist::-webkit-scrollbar{display:none;}
  .nav-item{
    flex:0 0 auto;width:auto;min-width:60px;
    flex-direction:column;gap:3px;text-align:center;white-space:nowrap;
    padding:7px 9px;font-size:10.2px;border-radius:10px;
  }
  .nav-item .ic{font-size:17px;}
  .nav-item.active{box-shadow:none;background:rgba(217,151,31,0.2);}

  /* page header */
  .page-head{flex-direction:column;align-items:stretch;gap:10px;margin-bottom:16px;}
  .page-title{font-size:18.5px;gap:8px;}
  .page-desc{font-size:12.3px;}
  .page-actions{flex-direction:column;gap:8px;}
  .page-actions>*{width:100%;justify-content:center;}

  /* cards */
  .cards-row{grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:9px;margin-bottom:18px;}
  .stat-card{padding:12px 13px;}
  .stat-card .stat-value{font-size:18px;}
  .stat-card .stat-label{font-size:11.8px;}

  /* panels + tables: scroll horizontally instead of squeezing columns */
  .panel{padding:14px 14px 16px;margin-bottom:14px;}
  .panel-title{font-size:14.5px;flex-wrap:wrap;}
  .table-scroll{border-radius:8px;}
  table.data-table{min-width:540px;font-size:12.6px;}
  .data-table thead th, .data-table tbody td{padding:9px 10px;}
  /* keep the first (label) column visible while scrolling the rest */
  .data-table thead th:first-child, .data-table tbody td:first-child{
    position:sticky;left:0;z-index:1;
    box-shadow:1px 0 0 var(--line-soft);
  }
  .data-table tbody td:first-child{background:var(--surface);}
  .data-table tbody tr:nth-child(even) td:first-child{background:#FBF8F1;}
  .data-table tbody tr:hover td:first-child{background:var(--surface-2);}

  /* toolbar */
  .toolbar{gap:8px;}
  .search-box{min-width:0;flex:1 1 100%;}
  select.filter-select{flex:1 1 100%;}

  /* modal as a bottom sheet */
  .modal-overlay{padding:0;align-items:flex-end;}
  .modal{
    max-width:100%;width:100%;border-radius:16px 16px 0 0;
    max-height:90vh;overflow-y:auto;
    padding:16px 16px calc(18px + env(safe-area-inset-bottom));
  }
  .modal-head h3{font-size:16px;}
  .modal-close{width:34px;height:34px;font-size:20px;}
  .modal-foot{flex-direction:column-reverse;gap:8px;}
  .modal-foot .btn{width:100%;justify-content:center;}

  /* forms */
  .form-grid, .form-grid.cols-3{grid-template-columns:1fr;}
  .field.span-2{grid-column:span 1;}
  .line-row{grid-template-columns:1fr;}

  /* bigger touch targets */
  .btn{min-height:42px;}
  .btn-sm{min-height:36px;}
  .icon-btn{width:36px;height:36px;}
  .seg-tab{padding:9px 14px;font-size:12.5px;}
  .field input, .field select, .field textarea{padding:10px 11px;font-size:16px;}

  .dash-toolbar{flex-direction:column;align-items:stretch;gap:10px;}
  .dash-toolbar .seg-tabs{width:100%;justify-content:space-between;}
  .dash-toolbar .seg-tab{flex:1 1 0;min-width:0;text-align:center;overflow:hidden;text-overflow:ellipsis;}

  /* keep toast above the bottom tab bar */
  .toast-wrap{bottom:calc(64px + env(safe-area-inset-bottom));}
}
</style>
</head>
<body>

<div class="app">
  <aside class="sidebar">
    <div class="brand"><span class="brand-mark"></span><span class="brand-text">Food Cost</span></div>
    <div class="brand-sub">ระบบจัดการต้นทุนและกำไรร้านอาหาร</div>
    <nav class="navlist" id="navlist">
      <button class="nav-item" data-page="dashboard"><span class="ic">📊</span><span>Dashboard</span></button>
      <button class="nav-item" data-page="ingredients"><span class="ic">🥬</span><span>วัตถุดิบ</span></button>
      <button class="nav-item" data-page="purchases"><span class="ic">🛒</span><span>การซื้อ</span></button>
