/* =========================================================
   MONTHLY REPORTS & EXPORT
   ========================================================= */
let reportMonth = todayStr().slice(0,7); // 'YYYY-MM'
function setReportMonth(v){
  if(!v) return;
  reportMonth = v;
  RENDERERS.reports();
}
function monthlySummary(monthKey){
  const start = monthKey+'-01';
  const end = monthKey+'-'+String(daysInMonthOf(monthKey)).padStart(2,'0');
  const sales = DB.sales.filter(s=>s.date>=start && s.date<=end);
  const sumField = (arr,f)=>arr.reduce((s,x)=>s+x[f],0);
  const totalRevenue = sumField(sales,'gross');
  const totalFoodCost = sumField(sales,'foodCostTotal');
  const totalPlatformFee = sales.reduce((s,x)=>s+x.platformFeeAmt+x.paymentFeeAmt+x.otherFeeAmt,0);
  const totalPromo = sumField(sales,'promoStoreShare');
  const grossProfit = sumField(sales,'actualProfit');
  const overhead = totalMonthlyOverhead();
  const netProfit = grossProfit - overhead;
  const qty = sales.reduce((s,x)=>s+x.qty,0);
  const byRecipe = {};
  sales.forEach(s=>{
    if(!byRecipe[s.recipeId]) byRecipe[s.recipeId] = {qty:0, revenue:0, foodCost:0, profit:0};
    byRecipe[s.recipeId].qty += s.qty;
    byRecipe[s.recipeId].revenue += s.gross;
    byRecipe[s.recipeId].foodCost += s.foodCostTotal;
    byRecipe[s.recipeId].profit += s.actualProfit;
  });
  const byDay = {};
  sales.forEach(s=>{
    if(!byDay[s.date]) byDay[s.date] = {qty:0, revenue:0, foodCost:0, profit:0};
    byDay[s.date].qty += s.qty;
    byDay[s.date].revenue += s.gross;
    byDay[s.date].foodCost += s.foodCostTotal;
    byDay[s.date].profit += s.actualProfit;
  });
  return {start, end, sales, totalRevenue, totalFoodCost, totalPlatformFee, totalPromo, grossProfit, overhead, netProfit, qty, byRecipe, byDay};
}

RENDERERS.reports = function(){
  const m = monthlySummary(reportMonth);
  const recipeRows = Object.entries(m.byRecipe).map(([rid,v])=>{
    const r = recipeById(rid);
    return `<tr><td class="cell-strong">${esc(r?r.name:'(ลบแล้ว)')}</td><td class="num">${fmtNum(v.qty)}</td><td class="num">${fmtMoney(v.revenue)}</td><td class="num">${fmtMoney(v.foodCost)}</td><td class="num" style="color:${v.profit>=0?'var(--good)':'var(--danger)'};font-weight:600;">${fmtMoney(v.profit)}</td></tr>`;
  }).join('') || `<tr class="empty-row"><td colspan="5">ไม่มีข้อมูลการขายในเดือนนี้</td></tr>`;

  const dailyRows = Object.keys(m.byDay).sort().map(d=>{
    const v = m.byDay[d];
    return `<tr><td>${fmtDate(d)}</td><td class="num">${fmtNum(v.qty)}</td><td class="num">${fmtMoney(v.revenue)}</td><td class="num" style="color:${v.profit>=0?'var(--good)':'var(--danger)'};font-weight:600;">${fmtMoney(v.profit)}</td></tr>`;
  }).join('') || `<tr class="empty-row"><td colspan="4">ไม่มีข้อมูล</td></tr>`;

  document.getElementById('page-reports').innerHTML = `
    <div class="page-head">
      <div><h1 class="page-title">🧾 รายงานสรุปรายเดือน</h1><p class="page-desc">สรุปยอดขาย ต้นทุน และกำไรรายเดือน สำหรับเก็บบัญชีหรือยื่นภาษี — export เป็น Excel หรือ PDF ได้</p></div>
      <div class="page-actions">
        <input type="month" id="reportMonthInput" value="${reportMonth}" onchange="setReportMonth(this.value)" style="border:1px solid var(--line);background:var(--surface);padding:8px 10px;border-radius:var(--radius-s);font-size:13.5px;">
        <button class="btn" onclick="exportReportExcel()">⬇️ Excel</button>
        <button class="btn btn-accent" onclick="exportReportPDF()">⬇️ PDF</button>
      </div>
    </div>

    <div class="cards-row">
      <div class="stat-card" style="--accent:var(--turmeric)"><div class="stat-label">ยอดขายรวม</div><div class="stat-value">${fmtMoney(m.totalRevenue)}</div><div class="stat-note">${fmtNum(m.qty)} จาน</div></div>
      <div class="stat-card" style="--accent:var(--turmeric)"><div class="stat-label">Food Cost รวม</div><div class="stat-value">${fmtMoney(m.totalFoodCost)}</div><div class="stat-note">บาท</div></div>
      <div class="stat-card" style="--accent:var(--clay)"><div class="stat-label">ค่าธรรมเนียม Platform รวม</div><div class="stat-value">${fmtMoney(m.totalPlatformFee)}</div><div class="stat-note">บาท</div></div>
      <div class="stat-card" style="--accent:var(--chili)"><div class="stat-label">Promotion ร้านรับผิดชอบ</div><div class="stat-value">${fmtMoney(m.totalPromo)}</div><div class="stat-note">บาท</div></div>
      <div class="stat-card" style="--accent:var(--herb)"><div class="stat-label">กำไรขั้นต้น</div><div class="stat-value">${fmtMoney(m.grossProfit)}</div><div class="stat-note">ก่อนหักต้นทุนคงที่</div></div>
      <div class="stat-card" style="--accent:var(--good)"><div class="stat-label">กำไรสุทธิ</div><div class="stat-value" style="color:${m.netProfit>=0?'var(--good-deep,#3F6B3F)':'var(--danger)'}">${fmtMoney(m.netProfit)}</div><div class="stat-note">หลังหักต้นทุนคงที่ ${fmtMoney(m.overhead)} บาท</div></div>
    </div>

    <div class="two-col">
      <div class="panel">
        <div class="panel-title">สรุปตามเมนู <small>เดือน ${fmtDate(m.start)} – ${fmtDate(m.end)}</small></div>
        <div class="table-scroll"><table class="data-table"><thead><tr><th>เมนู</th><th>จำนวน</th><th>ยอดขาย</th><th>Food Cost</th><th>กำไร</th></tr></thead><tbody>${recipeRows}</tbody></table></div>
      </div>
      <div class="panel">
        <div class="panel-title">สรุปรายวัน</div>
        <div class="table-scroll"><table class="data-table"><thead><tr><th>วันที่</th><th>จำนวน</th><th>ยอดขาย</th><th>กำไร</th></tr></thead><tbody>${dailyRows}</tbody></table></div>
      </div>
    </div>
  `;
};

function exportReportExcel(){
  if(typeof XLSX==='undefined'){ toast('โหลดไลบรารี Excel ไม่สำเร็จ กรุณาตรวจสอบอินเทอร์เน็ตแล้วลองใหม่'); return; }
  const m = monthlySummary(reportMonth);
  try{
    const summaryData = [
      ['รายงานสรุปยอดขาย/กำไร', reportMonth],
      ['ช่วงวันที่', `${m.start} ถึง ${m.end}`],
      [],
      ['รายการ','จำนวนเงิน (บาท)'],
      ['ยอดขายรวม', m.totalRevenue],
      ['Food Cost รวม', m.totalFoodCost],
      ['ค่าธรรมเนียม Platform รวม', m.totalPlatformFee],
      ['Promotion ร้านรับผิดชอบ', m.totalPromo],
      ['กำไรขั้นต้น', m.grossProfit],
      ['ต้นทุนคงที่รายเดือน', m.overhead],
      ['กำไรสุทธิ', m.netProfit],
      ['จำนวนจานที่ขาย', m.qty],
    ];
    const wsSummary = XLSX.utils.aoa_to_sheet(summaryData);

    const recipeData = [['เมนู','จำนวน','ยอดขาย','Food Cost','กำไร']];
    Object.entries(m.byRecipe).forEach(([rid,v])=>{
      const r = recipeById(rid);
      recipeData.push([r?r.name:'(ลบแล้ว)', v.qty, v.revenue, v.foodCost, v.profit]);
    });
    const wsRecipe = XLSX.utils.aoa_to_sheet(recipeData);

    const dailyData = [['วันที่','จำนวน','ยอดขาย','Food Cost','กำไร']];
    Object.keys(m.byDay).sort().forEach(d=>{
      const v = m.byDay[d];
      dailyData.push([d, v.qty, v.revenue, v.foodCost, v.profit]);
    });
    const wsDaily = XLSX.utils.aoa_to_sheet(dailyData);

    const detailData = [['วันที่','เมนู','ช่องทาง','จำนวน','ราคาขาย/หน่วย','ยอดขาย','Food Cost','กำไร']];
    m.sales.slice().sort((a,b)=> a.date<b.date?-1:(a.date>b.date?1:0)).forEach(s=>{
      const r = recipeById(s.recipeId), p = platformById(s.platformId);
      detailData.push([s.date, r?r.name:'-', p?p.name:'-', s.qty, s.sellingPrice, s.gross, s.foodCostTotal, s.actualProfit]);
    });
    const wsDetail = XLSX.utils.aoa_to_sheet(detailData);

    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, wsSummary, 'สรุป');
    XLSX.utils.book_append_sheet(wb, wsRecipe, 'ตามเมนู');
    XLSX.utils.book_append_sheet(wb, wsDaily, 'รายวัน');
    XLSX.utils.book_append_sheet(wb, wsDetail, 'รายการขาย');
    XLSX.writeFile(wb, `รายงาน-${reportMonth}.xlsx`);
    toast('ดาวน์โหลดรายงาน Excel แล้ว');
  } catch(e){
    toast('เกิดข้อผิดพลาดขณะสร้างไฟล์ Excel');
  }
}

