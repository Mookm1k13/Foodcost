function updateBreakEven(){
  const scopeEl = document.getElementById('be_scope');
  const manualEl = document.getElementById('be_manual');
  if(!scopeEl || !manualEl) return;
  const scope = scopeEl.value;
  const manualRaw = manualEl.value;
  const manual = manualRaw!=='' ? Number(manualRaw) : null;
  const totalOverhead = totalMonthlyOverhead();
  const perDay = totalOverhead/30;
  const resultEl = document.getElementById('be_result');

  if(totalOverhead<=0){
    resultEl.innerHTML = `<div class="muted" style="padding:6px 2px;">ยังไม่ได้กรอกต้นทุนคงที่ — เพิ่มรายการด้านซ้ายก่อนเพื่อคำนวณจุดคุ้มทุน</div>`;
    return;
  }

  let avgProfit = 0, basisNote = '';
  if(manual!==null && !isNaN(manual)){
    avgProfit = manual;
    basisNote = 'กำหนดเอง';
  } else {
    const sales = scope==='all' ? DB.sales : DB.sales.filter(s=>s.recipeId===scope);
    const qtyBasis = sales.reduce((s,x)=>s+x.qty,0);
    const profitSum = sales.reduce((s,x)=>s+x.actualProfit,0);
    avgProfit = qtyBasis>0 ? profitSum/qtyBasis : 0;
    basisNote = qtyBasis>0 ? `เฉลี่ยจากยอดขายจริง ${fmtNum(qtyBasis)} จาน` : 'ยังไม่มีประวัติการขาย ลองกรอกกำไรเฉลี่ยต่อจานเอง';
  }

  if(avgProfit<=0){
    resultEl.innerHTML = `
      <div class="calc-row"><span>ต้นทุนคงที่ต่อวัน</span><span>${fmtMoney(perDay)} บาท</span></div>
      <div class="calc-row"><span>กำไรขั้นต้นเฉลี่ยต่อจาน</span><span class="neg">${fmtMoney(avgProfit)} บาท <small class="muted">(${basisNote})</small></span></div>
      <div class="result-callout" style="border-color:var(--danger);margin-top:10px;">
        <div class="sub" style="color:var(--danger);font-weight:600;">⚠️ กำไรเฉลี่ยต่อจาน${avgProfit<0?'ติดลบ':'เท่ากับศูนย์'} — ยังคำนวณจุดคุ้มทุนไม่ได้ ต้องปรับราคาขายหรือลดต้นทุนก่อน</div>
      </div>`;
    return;
  }

  const perDayDishes = perDay/avgProfit;
  const perMonthDishes = totalOverhead/avgProfit;
  resultEl.innerHTML = `
    <div class="calc-row"><span>รวมต้นทุนคงที่ต่อเดือน</span><span>${fmtMoney(totalOverhead)} บาท</span></div>
    <div class="calc-row"><span>ต้นทุนคงที่ต่อวัน (÷30)</span><span>${fmtMoney(perDay)} บาท</span></div>
    <div class="calc-row"><span>กำไรขั้นต้นเฉลี่ยต่อจาน</span><span>${fmtMoney(avgProfit)} บาท <small class="muted">(${basisNote})</small></span></div>
    <div class="result-callout">
      <div class="big">${fmtNum(perDayDishes,1)} จาน/วัน</div>
      <div class="sub">ต้องขายอย่างน้อยเท่านี้ต่อวันถึงจะคุ้มทุนคงที่ (≈ ${fmtNum(perMonthDishes,0)} จาน/เดือน)</div>
    </div>
  `;
}

