/* ---------------- Dashboard: ช่วงเวลา / เช็คย้อนหลัง ---------------- */
let dashboardPeriod = 'all'; // 'today' | '7d' | 'month' | 'year' | 'all' | 'custom'
let dashboardCustomStart = null;
let dashboardCustomEnd = null;
function setDashboardPeriod(p){
  dashboardPeriod = p;
  RENDERERS.dashboard();
}
function applyDashboardCustomRange(){
  dashboardCustomStart = document.getElementById('dashCustomStart').value || null;
  dashboardCustomEnd = document.getElementById('dashCustomEnd').value || null;
  dashboardPeriod = 'custom';
  RENDERERS.dashboard();
}
function dashboardRangeForPeriod(){
  const today = todayStr();
  if(dashboardPeriod==='today') return {start:today, end:today, label:'วันนี้ ('+fmtDate(today)+')'};
  if(dashboardPeriod==='7d'){
    const d = new Date(today+'T00:00:00'); d.setDate(d.getDate()-6);
    const start = d.toISOString().slice(0,10);
    return {start, end:today, label:`${fmtDate(start)} – ${fmtDate(today)}`};
  }
  if(dashboardPeriod==='month'){
    const start = today.slice(0,7)+'-01';
    return {start, end:today, label:'เดือนนี้ ('+fmtDate(start)+' – '+fmtDate(today)+')'};
  }
  if(dashboardPeriod==='year'){
    const start = today.slice(0,4)+'-01-01';
    return {start, end:today, label:'ปีนี้ ('+fmtDate(start)+' – '+fmtDate(today)+')'};
  }
  if(dashboardPeriod==='custom'){
    if(dashboardCustomStart && dashboardCustomEnd) return {start:dashboardCustomStart, end:dashboardCustomEnd, label:`${fmtDate(dashboardCustomStart)} – ${fmtDate(dashboardCustomEnd)}`};
    if(dashboardCustomStart) return {start:dashboardCustomStart, end:null, label:`ตั้งแต่ ${fmtDate(dashboardCustomStart)}`};
    if(dashboardCustomEnd) return {start:null, end:dashboardCustomEnd, label:`ถึง ${fmtDate(dashboardCustomEnd)}`};
    return {start:null, end:null, label:'กำหนดเอง (ยังไม่ได้เลือกวันที่)'};
  }
  return {start:null, end:null, label:'ทั้งหมดทุกช่วงเวลา'};
}
function inDateRange(dateStr, range){
  if(range.start && dateStr<range.start) return false;
  if(range.end && dateStr>range.end) return false;
  return true;
}
// ช่วงก่อนหน้าที่มีความยาวเท่ากัน สำหรับเทียบ % การเปลี่ยนแปลง (ใช้ได้เมื่อมีทั้ง start และ end ชัดเจน)
function prevEquivalentRange(range){
  if(!range.start || !range.end) return null;
  const start = new Date(range.start+'T00:00:00');
  const end = new Date(range.end+'T00:00:00');
  const days = Math.round((end-start)/86400000)+1;
  const prevEnd = new Date(start); prevEnd.setDate(prevEnd.getDate()-1);
  const prevStart = new Date(prevEnd); prevStart.setDate(prevStart.getDate()-(days-1));
  return {start:prevStart.toISOString().slice(0,10), end:prevEnd.toISOString().slice(0,10)};
}
function trendNote(curr, prev){
  if(prev===0 || prev===null || prev===undefined) return 'ยังไม่มีข้อมูลช่วงก่อนหน้าเทียบ';
  const pct = (curr-prev)/Math.abs(prev)*100;
  return pct>=0 ? `▲ เพิ่มขึ้น ${fmtNum(pct,1)}% จากช่วงก่อนหน้า` : `▼ ลดลง ${fmtNum(Math.abs(pct),1)}% จากช่วงก่อนหน้า`;
}

