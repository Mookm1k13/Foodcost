function saveRecipe(id){
  const name = document.getElementById('f_name').value.trim();
  if(!name){ toast('กรุณากรอกชื่อเมนู'); return; }
  const rows = document.querySelectorAll('#lineRows .line-row');
  const items = [];
  rows.forEach(row=>{
    const ingredientId = row.querySelector('.rl-ing').value;
    const qty = Number(row.querySelector('.rl-qty').value);
    const unit = row.querySelector('.rl-unit').value.trim();
    if(ingredientId && qty>0 && unit) items.push({ingredientId, qty, unit});
  });
  if(items.length===0){ toast('กรุณาเพิ่มวัตถุดิบอย่างน้อย 1 รายการ'); return; }
  const costRows = document.querySelectorAll('#costRows .cost-line-row');
  const otherCostItems = [];
  costRows.forEach(row=>{
    const cname = row.querySelector('.cl-name').value.trim();
    const amount = Number(row.querySelector('.cl-amount').value)||0;
    if(cname) otherCostItems.push({name:cname, amount});
  });
  const otherCost = otherCostItems.reduce((s,x)=>s+(Number(x.amount)||0),0);
  const data = {
    name, category: document.getElementById('f_category').value.trim(),
    otherCostItems, otherCost,
    items
  };
  if(id){ Object.assign(recipeById(id), data); }
  else { DB.recipes.push({id:uid(), ...data}); }
  save('recipes');
  closeModal();
  toast('บันทึกสูตรอาหารแล้ว');
  RENDERERS.recipes();
}
function deleteRecipe(id){
  if(!confirm('ลบสูตรอาหารนี้?')) return;
  DB.recipes = DB.recipes.filter(r=>r.id!==id);
  save('recipes');
  toast('ลบสูตรอาหารแล้ว');
  RENDERERS.recipes();
}

